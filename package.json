{
  "name": "contextual-dictionary",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension that defines the word you select and lists the meaning that fits the passage first, using a local model.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "pretest:e2e": "node scripts/build.mjs && node scripts/build.mjs --e2e",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run typecheck && npm test && npm run build && npm run check:build",
    "check:build": "node scripts/check-build.mjs dist",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@noble/hashes": "2.4.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "~5.9.2",
    "vitest": "5.1.1"
  }
}
