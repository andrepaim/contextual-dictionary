{
  "name": "@andrepaim/contextual-dictionary-core",
  "version": "0.3.0",
  "description": "Portable Wiktionary pack lookup and contextual sense ordering",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./card.css": "./dist/card.css",
    "./card-fixture": {
      "types": "./dist/card-fixture.d.ts",
      "default": "./dist/card-fixture.js"
    },
    "./package.json": "./package.json"
  }
}
